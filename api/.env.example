# watsonx.ai credentials (get from ibm.biz/midevfest26 → IBM Cloud account)
WATSONX_API_KEY=your_ibm_cloud_api_key_here
WATSONX_PROJECT_ID=your_watsonx_project_id_here
WATSONX_URL=https://us-south.ml.cloud.ibm.com

# Google Maps (for trail rendering in the frontend)
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# Server
PORT=3001

# ⚠️  NEVER commit the real .env file to git.
# This .env.example is safe to commit — it contains no real secrets.
